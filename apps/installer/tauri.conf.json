{
	"$schema": "https://schema.tauri.app/config/2",
	"productName": "Chunk Setup",
	"version": "../lemine/package.json",
	"identifier": "LeMine.Installer",
	"build": {
		"frontendDist": "./ui"
	},
	"bundle": {
		"active": false,
		"icon": ["../app/icons/icon.ico"]
	},
	"app": {
		"withGlobalTauri": true,
		"windows": [
			{
				"label": "main",
				"title": "Установка Chunk",
				"width": 460,
				"height": 560,
				"resizable": false,
				"maximizable": false,
				"decorations": false,
				"center": true,
				"visible": false
			}
		],
		"security": {
			"csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' data:"
		}
	}
}
